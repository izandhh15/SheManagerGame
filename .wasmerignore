# .wasmerignore — qué NO se empaqueta en el deploy
# vendor/ SÍ se incluye (composer install se ejecuta antes de desplegar)
.git/
.github/
node_modules/
tests/
.gitignore
.env
.env.*
!.env.example
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
